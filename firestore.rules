rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /groups/{groupId} {
      // Allow read to authenticated users and prospective members inspecting invite links
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.organiserId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.organiserId == request.auth.uid;

      match /contributions/{contributionId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
      }

      match /activities/{activityId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
      }
    }
  }
}
